# Default: point the app at the live production API (reliable demo, real data).
# To TEST YOUR BACKEND through the preview UI instead, set this to /api so the
# frontend makes same-origin requests that the Vite dev proxy forwards to the
# backend (no CORS, cookies work). See vite.config.js.
#   PUBLIC_API_URL=/api
PUBLIC_API_URL=https://projects.penguinmod.com
# Self-hosted editor fork (wycats/penguinmod.github.io -> penguinmod-studio).
# It is configured to talk to our own backend and proxies /PenguinMod-Packager/*
# to penguinmod-packager. Set to https://studio.penguinmod.com to use upstream.
PUBLIC_STUDIO_URL=https://penguinmod-studio.vercel.app
PUBLIC_MAX_UPLOAD_SIZE=32 # in megabytes
PUBLIC_CAPTCHA_ENABLED=true # If this is false, it must also be false on API to function correctly.

# Where the /api dev proxy forwards to. Defaults to the deployed backend.
# Set to http://localhost:8080 to test a locally-running backend (needs secrets/DB).
#   BACKEND_PROXY_TARGET=https://penguinmod-backend.vercel.app
