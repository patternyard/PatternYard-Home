# Default: point the app at the live PatternYard API (reliable demo, real data).
# To TEST YOUR BACKEND through the preview UI instead, set this to /api so the
# frontend makes same-origin requests that the Vite dev proxy forwards to the
# backend (no CORS, cookies work). See vite.config.js.
#   PUBLIC_API_URL=/api
PUBLIC_API_URL=https://api.patternyard.dev
# PatternYard editor (scratch-gui fork). It talks to our own backend and
# proxies /PenguinMod-Packager/* to the packager.
PUBLIC_STUDIO_URL=https://studio.patternyard.dev
PUBLIC_MAX_UPLOAD_SIZE=32 # in megabytes
PUBLIC_CAPTCHA_ENABLED=true # If this is false, it must also be false on API to function correctly.

# Where the /api dev proxy forwards to. Defaults to the deployed PatternYard backend.
# Set to http://localhost:8080 to test a locally-running backend (needs secrets/DB).
#   BACKEND_PROXY_TARGET=https://api.patternyard.dev
